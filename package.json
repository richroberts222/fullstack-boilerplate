{
  "name": "app-boilerplate",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:run": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "test:scripts": "node --test scripts/fix-has-guard.test.mjs scripts/dependency-match.test.mjs scripts/e2e-summary.test.mjs",
    "validate": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm test:scripts && pnpm build && pnpm test:boilerplate",
    "init:app": "node scripts/boilerplate/init-app.mjs",
    "check:boilerplate": "node scripts/boilerplate/check-boilerplate.mjs",
    "test:boilerplate": "node --test scripts/boilerplate/boilerplate.test.mjs",
    "prove:init": "node scripts/boilerplate/prove-init.mjs",
    "addon:apply": "node scripts/boilerplate/apply-addon.mjs"
  }
}
